-- table: Aggregated EUX Results
-- name: Max EUX Gauge Values
-- format:
-- description: CHANGED 1.1.0.2. BLANK instead of 0 when no single run is selected. Grain: maximum of the aggregated EUX score rows (per-timestamp scores), not of raw per-session scores.
IF(
    HASONEVALUE('Filtered Test Runs'[id]),
    MAX('Aggregated EUX Results'[score]),
    BLANK()
)
