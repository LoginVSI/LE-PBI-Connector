-- table: Test Runs
-- name: Total Test Runs
-- format: 0
-- description: 
VAR Last30Days =
    FILTER(
        ALL('Test Runs'),
        'Test Runs'[Started] >= TODAY() - 30 &&
        'Test Runs'[Started] <= TODAY()
    )

VAR ApplicationLoadTestsCount =
    CALCULATE(
        COUNTROWS('Test Runs'),
        Last30Days,
        'Test Runs'[type] IN { "ApplicationTest", "LoadTest" }
    )

VAR ContinuousTestsWithMeasurementsCount =
    CALCULATETABLE(
        FILTER(
            'Test Runs',
            'Test Runs'[type] = "ContinuousTest" &&
            NOT ISEMPTY(
                FILTER(
                    'Measurements',
                    'Measurements'[testRunId] = 'Test Runs'[id]
                )
            )
        ),
        Last30Days
    )

RETURN
ApplicationLoadTestsCount +
COUNTROWS(ContinuousTestsWithMeasurementsCount)
