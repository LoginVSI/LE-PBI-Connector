-- table: Test Runs
-- name: First Login Success Count (No Data)
-- format:
-- description:
VAR FirstValue =
    CALCULATE(
        FIRSTNONBLANK('Test Runs'[login_successCount], 1)
    )
RETURN
    IF(
        NOT HASONEVALUE ( 'Filtered Test Runs'[id] ) || ISBLANK(FirstValue),
        "No Data",
        FORMAT(FirstValue, "0")
    )
