-- table: Test Runs
-- name: Overall Success Rate (%)
-- format:
-- description: CHANGED 1.1.0.2. Display text over the unfiltered Test Runs table. Denominator = finished (result not blank) Application/Load runs, no longer limited to runs that have Measurements.
VAR Denominator =
    CALCULATE (
        COUNTROWS ( 'Test Runs' ),
        KEEPFILTERS ( 'Test Runs'[type] IN { "ApplicationTest", "LoadTest" } ),
        KEEPFILTERS ( 'Test Runs'[result] <> BLANK () )
    )
VAR Successful =
    CALCULATE (
        COUNTROWS ( 'Test Runs' ),
        KEEPFILTERS ( 'Test Runs'[type] IN { "ApplicationTest", "LoadTest" } ),
        KEEPFILTERS ( 'Test Runs'[result] IN { "successful", "completed" } )
    )
RETURN
    IF (
        COALESCE ( Denominator, 0 ) = 0,
        "No Data",
        FORMAT ( DIVIDE ( COALESCE ( Successful, 0 ), Denominator ) * 100, "0.0" )
    )
