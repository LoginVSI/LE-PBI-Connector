-- table: Filtered Test Runs
-- name: First Login Total Count (No Data & Filtered Test Runs)
-- format: 
-- description: 
VAR FirstValue =
    CALCULATE(
        SELECTEDVALUE('Filtered Test Runs'[login_totalCount], 1)
    )
RETURN
    IF(
        NOT HASONEVALUE ( 'Filtered Test Runs'[id] ) || ISBLANK(FirstValue),
        "No Data",
        FORMAT(FirstValue, "0")
    )
