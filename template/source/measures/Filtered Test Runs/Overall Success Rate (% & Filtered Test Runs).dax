-- table: Filtered Test Runs
-- name: Overall Success Rate (% & Filtered Test Runs)
-- format: 
-- description: 
VAR BaseRuns =
    FILTER(
        'Filtered Test Runs',
        LOWER ( 'Filtered Test Runs'[type] ) IN { "applicationtest", "loadtest" }
    )

VAR ValidRunsWithMeasurements =
    FILTER(
        BaseRuns,
        'Filtered Test Runs'[id] IN DISTINCT ( 'Measurements'[testRunId] )
    )

VAR TotalRuns =
    COUNTROWS ( ValidRunsWithMeasurements )

VAR SuccessfulRuns =
    COUNTROWS (
        FILTER(
            ValidRunsWithMeasurements,
            LOWER ( COALESCE ( 'Filtered Test Runs'[result], "" ) ) IN { "successful", "completed" }
        )
    )

RETURN
    IF (
        TotalRuns = 0,
        "No Data",
        FORMAT ( DIVIDE ( SuccessfulRuns, TotalRuns, 0 ) * 100, "0.0" )
    )
