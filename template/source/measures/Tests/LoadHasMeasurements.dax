-- table: Tests
-- name: LoadHasMeasurements
-- format: 0
-- description: Compatibility identifier. Tests filters Filtered Test Runs through the active relationship. Includes failed Application/Load runs without measurements.
IF ( CALCULATE ( [Eligible Test Runs (Filtered Test Runs)], KEEPFILTERS ( 'Filtered Test Runs'[type] = "loadtest" ) ) > 0, 1, 0 )
