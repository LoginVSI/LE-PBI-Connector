-- table: Tests
-- name: HasMeasurements
-- format: 0
-- description: 
VAR CurrentTestId = MAX('Tests'[id])

-- Get the type of the current Test
VAR TestType =
    LOOKUPVALUE (
        'Tests'[type],
        'Tests'[id],
        CurrentTestId
    )

-- Check if the type is one of the included types
VAR IsIncludedTestType =
    TestType IN { "ContinuousTest", "LoadTest", "ApplicationTest" }

-- Get Measurement count directly via relationships
VAR MeasurementCount =
    CALCULATE (
        COUNTROWS('Measurements'),
        FILTER (
            'Test Runs',
            'Test Runs'[testId] = CurrentTestId
        ),
        'Measurements'
    )

RETURN
    IF (
        IsIncludedTestType && MeasurementCount > 0,
        1,
        0
    )
