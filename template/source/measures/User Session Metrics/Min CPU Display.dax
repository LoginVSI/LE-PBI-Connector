-- table: User Session Metrics
-- name: Min CPU Display
-- format: 
-- description: 
VAR CPUValues =
    FILTER (
        'User Session Metrics',
        'User Session Metrics'[displayName] = "CPU"
    )
VAR MinCPU =
    MINX ( CPUValues, 'User Session Metrics'[measurement] )
RETURN
    IF (
        NOT HASONEVALUE ( 'Filtered Test Runs'[id] ) || ISBLANK ( MinCPU ),
        "No Data",
        FORMAT ( MinCPU, "#,0.00" )
    )
