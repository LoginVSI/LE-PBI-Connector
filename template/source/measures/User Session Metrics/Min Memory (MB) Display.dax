-- table: User Session Metrics
-- name: Min Memory (MB) Display
-- format:
-- description:
VAR MemoryValues =
    FILTER (
        'User Session Metrics',
        'User Session Metrics'[displayName] = "Memory"
    )
VAR MinMemory =
    MINX ( MemoryValues, 'User Session Metrics'[measurement] )
RETURN
    IF (
        NOT HASONEVALUE ( 'Filtered Test Runs'[id] ) || ISBLANK ( MinMemory ),
        "No Data",
        FORMAT ( MinMemory, "#,0.00" )
    )
