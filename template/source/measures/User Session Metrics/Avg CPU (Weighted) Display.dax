-- table: User Session Metrics
-- name: Avg CPU (Weighted) Display
-- format:
-- description: NEW 1.1.0.2. Display text of Avg CPU Weighted Value; requires a single selected run like the legacy display measures.
VAR v = [Avg CPU Weighted Value]
RETURN
    IF ( NOT HASONEVALUE ( 'Filtered Test Runs'[id] ) || ISBLANK ( v ), "No Data", FORMAT ( v, "#,0.00" ) )
