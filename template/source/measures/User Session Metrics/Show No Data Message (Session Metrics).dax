-- table: User Session Metrics
-- name: Show No Data Message (Session Metrics)
-- format:
-- description: CHANGED 1.1.0.2. No Data when there are no rows. Previously tested SUM(measurement) = 0, which mislabelled valid all-zero metrics as No Data (used by the Continuous page).
IF (
    COUNTROWS ( 'User Session Metrics' ) = 0,
    "No Data",
    ""
)
