-- table: Measurements
-- name: Total Login Time No Data
-- format:
-- description:
VAR FilteredCount =
    CALCULATE (
        COUNTROWS ( 'Measurements' ),
        'Measurements'[measurementId] = "total_login_time"
    )
RETURN
    IF (
        FilteredCount = 0 || ISBLANK(FilteredCount),
        "No Data",
        ""
    )
