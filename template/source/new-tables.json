        { "name": "isBase", "dataType": "boolean", "summarizeBy": "none" },
        { "name": "state", "dataType": "string", "summarizeBy": "none" },
        { "name": "testResult", "dataType": "string", "summarizeBy": "none" },
        { "name": "euxState", "dataType": "string", "summarizeBy": "none" },
        { "name": "vsiMaxState", "dataType": "string", "summarizeBy": "none" },
        { "name": "euxScore", "dataType": "double", "summarizeBy": "none", "formatString": "0.0" },
        { "name": "euxBaseline", "dataType": "double", "summarizeBy": "none", "formatString": "0.0" },
        { "name": "euxSteadyState", "dataType": "double", "summarizeBy": "none", "formatString": "0.0" },
        { "name": "vsiMax", "dataType": "double", "summarizeBy": "none", "formatString": "0.0" }
      ]
    }
